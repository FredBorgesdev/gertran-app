{
  "name": "enlink",
  "version": "7.0.0",
  "scripts": {
    "ng": "ng",
    "serve": "ng serve",
    "start": "ng serve --port 4200 -o --configuration=dev",
    "build": "ng build --prod",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build-prod": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration production",
    "build-prod-state": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration production --stats-json",
    "bundle-report": "webpack-bundle-analyzer dist/enlink/stats.json",
    "generate:crud": "ng g ./crud/src/collection.json:crud"
  },
  "engines": {
    "node": "14.18.2",
    "npm": "6.14.15"
  },
  "private": true,
  "dependencies": {
